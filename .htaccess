RewriteEngine On
RewriteBase /immolode-php/

# 1. Rediriger la racine vers /immolode-php/client/
RewriteRule ^$ client/ [L,R=302]

# 2. URLs propres PHP (ex. /immolode-php/client/biens -> /immolode-php/client/biens.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

ErrorDocument 404 /immolode-php/404.php

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
